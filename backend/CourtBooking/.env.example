# ─────────────────────────────────────────────────────────────
# .env.example — Commit this file to version control.
#                Copy to .env and fill in real values locally.
#                NEVER commit the real .env file!
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080

# ── SQL Server ───────────────────────────────────────────────
# Password MUST be strong: uppercase + lowercase + digit + special char, min 8 chars
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!Pass
MSSQL_DB=CourtBooking
MSSQL_PORT=1433
# Developer (free, local only) | Express | Standard | Enterprise
MSSQL_PID=Developer

# ── Connection Strings ────────────────────────────────────────
# Dùng __ (double underscore) để ASP.NET Core map thành ConnectionStrings:DefaultConnection
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=CourtBooking;User Id=sa;Password=CHANGE_ME_Str0ng!Pass;TrustServerCertificate=True;MultipleActiveResultSets=True;

# ── Seq ──────────────────────────────────────────────────────
# Generate the admin password hash with:
#   docker run --rm datalust/seq seq hash --pass <YourPassword>
SEQ_ADMIN_PASSWORD_HASH=CHANGE_ME_RUN_HASH_COMMAND

# Optional: Create an API key in Seq UI → Settings → API Keys, then paste here.
# Leave empty to allow unauthenticated ingestion (only for local dev).
SEQ_API_KEY=

# Seq ports exposed on host
SEQ_UI_PORT=5341        # Access Seq UI at http://localhost:5341
SEQ_INGESTION_PORT=5342 # Serilog sends logs to http://localhost:5342
